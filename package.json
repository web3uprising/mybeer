{
  "name": "mybeer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/wallet",
    "apps/terminal",
    "evm"
  ],
  "scripts": {
    "build": "npm run build -w apps/wallet -w apps/terminal",
    "typecheck": "tsc -p . && npm run typecheck -w apps/wallet -w apps/terminal",
    "test": "npm test -w evm",
    "compile": "npm run export-abi -w evm"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "viem": "^2.57.3"
  }
}
